{
  "name": "energia-inteligente",
  "private": true,
  "version": "1.0.0",
  "description": "Monitoramento inteligente do consumo de energia por cômodo (ESP32 + Supabase + Vercel)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env scripts/dev-api.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "simulate": "node --env-file-if-exists=.env scripts/simulate-esp32.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.1"
  }
}
